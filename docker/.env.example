# OpenClaw Docker 本地部署配置
# 复制此文件为 .env 并填入你的配置

# OpenClaw 网关 Token（自动生成或自定义）
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# Worker 通信 Token（与本地 Worker 保持一致）
WORKER_TOKEN=your-worker-token-here

# Bot callback 身份（首选；旧的 DISCORD_BOT_TOKEN 仍兼容）
# CALLBACK_BOT_TOKEN=your-bot-token-here

# 可选：覆盖 callback API 基础地址（默认兼容 Discord API）
# CALLBACK_API_BASE_URL=https://discord.com/api/v10

# 配置目录（可选，默认 ~/.openclaw-docker）
# OPENCLAW_CONFIG_DIR=~/.openclaw-docker

# 工作区目录（可选，默认 ~/openclaw-workspace）
# OPENCLAW_WORKSPACE_DIR=~/openclaw-workspace

# Task API 持久化状态（可选）
# WORKER_TASK_DB=/tmp/openclaw-runner-tasks.db
# WORKER_EVENT_DB=/tmp/openclaw-runner-events.db
# WORKER_TASK_RETENTION_MS=1200000
# WORKER_RESULT_RETENTION_MS=1800000
# WORKER_SESSION_RETENTION_MS=1800000
# WORKER_EVENT_RETENTION_DAYS=14
# WORKER_MAX_EVENTS=2000

# 本地 runner provider cache（可选）
# RUNNER_SESSION_CACHE_FILE=/tmp/openclaw-runner-session-cache.json
# RUNNER_SESSION_RETENTION_MS=1800000
